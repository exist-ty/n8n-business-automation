# Генерируется один раз: python -c "import secrets; print(secrets.token_hex(16))"
N8N_ENCRYPTION_KEY=

# Пароль для роли n8n_readonly (см. sql/readonly_role.sql, sql/readonly_role_triage.sql)
N8N_READONLY_DB_PASSWORD=

# Пароль для отдельной, более узкой роли Self-Service Analytics Bot
# (см. sql/readonly_role_selfservice.sql)
N8N_SELFSERVICE_DB_PASSWORD=

# Telegram: создать бота через @BotFather (/newbot), забрать chat_id через
# getUpdates после того, как боту написали /start
TELEGRAM_ALERT_CHAT_ID=

# SMTP: адрес отправителя и получателя для алертов/дайджестов
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Notion: notion.so/my-integrations -> New integration -> токен; затем
# расшарить целевую страницу с этой интеграцией (Share/Connections в UI —
# через API доступ выдать нельзя)
NOTION_API_TOKEN=
NOTION_DOCS_PAGE_ID=

# Weekly AI Business Digest (workflows/04): по умолчанию — локальная
# Qwen2.5-3B через Ollama (host.docker.internal:11434), без единого внешнего
# API-вызова. DIGEST_LLM_BACKEND=groq переключает на облачную Llama 3.3 70B
# Instruct (Groq) — текст дайджеста (агрегированные бизнес-метрики, не
# персональные данные клиентов) в этом случае уходит по HTTPS на Groq.
DIGEST_LLM_BACKEND=ollama
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
