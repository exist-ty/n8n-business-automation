{
  "id": "7b3e9d2c4f1a4e8b",
  "name": "Notion Auto Documentation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "docs-refresh",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1000, 0],
      "webhookId": "docs-refresh"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.relname AS table_name, d.description AS table_description, a.attname AS column_name, pg_catalog.format_type(a.atttypid, a.atttypmod) AS data_type, a.attnum AS ordinal_position FROM pg_catalog.pg_class c JOIN data_catalog_descriptions d ON d.object_name = c.relname JOIN pg_catalog.pg_attribute a ON a.attrelid = c.oid WHERE c.relkind IN ('r', 'v', 'm') AND a.attnum > 0 AND NOT a.attisdropped ORDER BY c.relname, a.attnum;",
        "options": {}
      },
      "id": "fetch-catalog",
      "name": "Fetch catalog",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-780, 0],
      "credentials": {
        "postgres": {
          "id": "postgres-etl-readonly",
          "name": "Postgres (etl_portfolio, n8n_readonly)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst byTable = {};\nfor (const r of rows) {\n  if (!byTable[r.table_name]) byTable[r.table_name] = { description: r.table_description, columns: [] };\n  byTable[r.table_name].columns.push({ name: r.column_name, type: r.data_type });\n}\n\n// Notion API: max 100 children per PATCH append — при 7 объектах x ~8\n// строк (heading + описание + колонки) укладываемся с запасом; для\n// каталога заметно больше объектов потребовалась бы разбивка на чанки.\nconst children = [];\nfor (const [table, info] of Object.entries(byTable)) {\n  children.push({ object: 'block', type: 'heading_2', heading_2: { rich_text: [{ type: 'text', text: { content: table } }] } });\n  children.push({ object: 'block', type: 'paragraph', paragraph: { rich_text: [{ type: 'text', text: { content: info.description } }] } });\n  for (const col of info.columns) {\n    children.push({ object: 'block', type: 'bulleted_list_item', bulleted_list_item: { rich_text: [{ type: 'text', text: { content: `${col.name}: ${col.type}` } }] } });\n  }\n}\n\nconst summary_message = `\\ud83d\\udcc4 Notion-\\u0434\\u043e\\u043a\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\\u0446\\u0438\\u044f \\u043e\\u0431\\u043d\\u043e\\u0432\\u043b\\u0435\\u043d\\u0430: ${Object.keys(byTable).length} \\u043e\\u0431\\u044a\\u0435\\u043a\\u0442\\u043e\\u0432, ${rows.length} \\u043a\\u043e\\u043b\\u043e\\u043d\\u043e\\u043a.`;\n\nreturn [{ json: { children, summary_message, table_count: Object.keys(byTable).length } }];"
      },
      "id": "build-blocks",
      "name": "Build blocks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-560, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.notion.com/v1/blocks/{{ $env.NOTION_DOCS_PAGE_ID }}/children?page_size=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.NOTION_API_TOKEN }}" },
            { "name": "Notion-Version", "value": "2022-06-28" }
          ]
        },
        "options": {}
      },
      "id": "get-existing-blocks",
      "name": "Get existing blocks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-340, 0]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst ids = (response.results || []).map(b => b.id);\nreturn ids.length > 0 ? ids.map(id => ({ json: { id } })) : [{ json: { skip: true } }];"
      },
      "id": "extract-block-ids",
      "name": "Extract block ids",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-120, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://api.notion.com/v1/blocks/{{ $json.id || 'none' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.NOTION_API_TOKEN }}" },
            { "name": "Notion-Version", "value": "2022-06-28" }
          ]
        },
        "options": {}
      },
      "id": "delete-block",
      "name": "Delete old block",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [100, 0],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {} }];"
      },
      "id": "deletes-done",
      "name": "Deletes done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/blocks/{{ $env.NOTION_DOCS_PAGE_ID }}/children",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.NOTION_API_TOKEN }}" },
            { "name": "Notion-Version", "value": "2022-06-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ children: $('Build blocks').first().json.children }) }}",
        "options": {}
      },
      "id": "append-blocks",
      "name": "Append new blocks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ALERT_CHAT_ID }}",
        "text": "={{ $('Build blocks').first().json.summary_message }}",
        "additionalFields": {}
      },
      "id": "telegram-send",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [760, 0],
      "credentials": {
        "telegramApi": {
          "id": "telegram-alerts",
          "name": "Telegram bot (alerts)"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Fetch catalog", "type": "main", "index": 0 }]]
    },
    "Fetch catalog": {
      "main": [[{ "node": "Build blocks", "type": "main", "index": 0 }]]
    },
    "Build blocks": {
