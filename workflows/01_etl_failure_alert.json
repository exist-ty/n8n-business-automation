{
  "id": "c678da88865f40b1",
  "name": "ETL Failure Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "etl-failure-alert",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-200, 0],
      "webhookId": "etl-failure-alert"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst message = [\n  `❌ ETL Failure Alert`,\n  ``,\n  `DAG: ${body.dag_id}`,\n  `Task: ${body.task_id}`,\n  `Execution date: ${body.execution_date}`,\n  `Exception: ${body.exception}`,\n  `Log: ${body.log_url}`\n].join('\\n');\nreturn [{ json: { ...body, message } }];"
      },
      "id": "format-message",
      "name": "Format alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ALERT_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {}
      },
      "id": "telegram-send",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [240, -80],
      "credentials": {
        "telegramApi": {
          "id": "telegram-alerts",
          "name": "Telegram bot (alerts)"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.ALERT_EMAIL_FROM }}",
        "toEmail": "={{ $env.ALERT_EMAIL_TO }}",
        "subject": "=ETL Failure: {{ $json.dag_id }} / {{ $json.task_id }}",
        "text": "={{ $json.message }}",
        "options": {}
      },
      "id": "email-send",
      "name": "Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [240, 80],
      "credentials": {
        "smtp": {
          "id": "smtp-alerts",
          "name": "SMTP (alerts)"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Format alert", "type": "main", "index": 0 }]]
    },
    "Format alert": {
      "main": [
        [
          { "node": "Telegram", "type": "main", "index": 0 },
          { "node": "Email", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
